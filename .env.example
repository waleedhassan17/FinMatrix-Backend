# ===== App =====
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=FinMatrix
APP_URL=http://localhost:3000

# ===== Database (matches docker-compose.yml) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=finmatrix_user
DB_PASSWORD=finmatrix_pass_change_me
DB_NAME=finmatrix
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_MIGRATIONS_RUN=false

# ===== JWT =====
JWT_SECRET=generate_48_char_base64_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_different_48_char_base64_secret
JWT_REFRESH_EXPIRES_IN=30d

# ===== Security =====
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100
COOKIE_SECRET=generate_48_char_base64_secret

# ===== Logging =====
LOG_LEVEL=debug
LOG_PRETTY=true

# ===== File Uploads =====
UPLOAD_MAX_SIZE_MB=5
UPLOAD_STORAGE_PATH=./storage

# ===== Email / SMTP =====
# Leave EMAIL_ENABLED=false for local dev — all emails (verification links,
# OTPs, approval/rejection notices) are printed to the server console instead
# of being sent. Set to true and fill in the SMTP_* values to send real email.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Either SMTP_PASSWORD or SMTP_PASS works.
SMTP_PASSWORD=
# Send from a domain you own, through a transactional provider (e.g. Amazon
# SES), never from a personal Gmail/Outlook address: that is what puts
# verification emails in spam. The domain needs, in DNS:
#   SPF   TXT  @              v=spf1 include:<your provider> ~all
#   DKIM  the CNAME/TXT records your provider generates
#   DMARC TXT  _dmarc         v=DMARC1; p=none; rua=mailto:dmarc@<your-domain>
# and WEB_APP_URL should be on that same domain (e.g. https://app.<your-domain>).
# The server logs a warning at startup for each of these it finds missing.
# If unset, mail is sent as SMTP_USER when that is an email address.
SMTP_FROM=FinMatrix <no-reply@finmatrix.pk>
# Optional: where replies go, e.g. a support inbox.
SMTP_REPLY_TO=

# ===== Deep Links / Email Verification =====
# The owner web app that verification links open. Defaults to the current
# Vercel deployment; set it to your own domain (see the Email section above).
# WEB_APP_URL=https://app.your-domain
# Custom URL scheme used in verification deep links: finmatrix://verify-email?token=...
APP_DEEP_LINK_SCHEME=finmatrix
# Web fallback page shown when the app is not installed. Defaults to
# <APP_URL>/<API_PREFIX>/auth (which serves GET /auth/verify).
WEB_FALLBACK_URL=http://localhost:3000/api/v1/auth
# How long verification links stay valid.
VERIFICATION_TTL_HOURS=24

# ===== Forgot-Password OTP =====
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ===== Platform Admin Seed (npm run seed:superadmin) =====
# Used to seed the PLATFORM_ADMIN (super_admin) account. Never commit real
# secrets — set these locally / in your host's secret manager. Rotate any
# password that has ever been shared in plaintext.
ADMIN_EMAIL=platform-admin@example.com
ADMIN_PASSWORD=change_me_strong_password
ADMIN_NAME=Platform Admin

# ===== Feature Flags =====
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Cloudinary (durable file storage — POD photos, payment screenshots)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry error monitoring (leave empty to disable)
SENTRY_DSN=

# ─── Credential vault ───────────────────────────────────────────────
# Encrypts the custodian copy of owner-issued staff/rider passwords, so a
# database dump never yields a usable password. 32 bytes, base64 or hex.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset = the shareable copy is simply not stored; accounts still work.
CREDENTIAL_ENCRYPTION_KEY=

# ─── FinMatrix Connect (WhatsApp Cloud API) ─────────────────────────
# false = fake provider (nothing reaches Meta; statuses are simulated).
WHATSAPP_ENABLED=false
# Graph API version, e.g. v26.0 (the newest in Meta's changelog when you set it).
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Only for `npm run messaging:templates:sync`: the Meta app id, used to upload
# the sample PDF Meta asks for when templates with a PDF header are submitted.
WHATSAPP_APP_ID=
# 32 bytes base64; encrypts companies' own access tokens.
MESSAGING_ENCRYPTION_KEY=
# false stops this process from dispatching messages and running reminders.
MESSAGING_WORKER_ENABLED=true

# ── Company backup (Settings → Backup & export) ────────────────────────────
# Signs the download links of finished backups. 32+ random characters
# (`openssl rand -base64 48`). Required in production; in development it is
# derived from JWT_SECRET when unset. Rotating it only invalidates links.
EXPORT_TOKEN_SECRET=
# false stops this process from building queued backups (another drains them).
EXPORT_WORKER_ENABLED=true
# How long a finished backup can be downloaded, in hours.
EXPORT_RETENTION_HOURS=24

# ── Migration Center (Settings → Move to FinMatrix) ─────────────────────────
# Largest single uploaded file, in bytes (default 25 MB).
MIGRATION_MAX_FILE_BYTES=26214400
# The AI mapping assistant. Off by default: when on, up to 20 sample rows per
# sheet are sent to the model. MIGRATION_AI_MODEL is required when enabled.
MIGRATION_AI_ENABLED=false
MIGRATION_AI_MODEL=
ANTHROPIC_API_KEY=
MIGRATION_AI_MAX_CALLS=10
MIGRATION_AI_SERVER_FALLBACK=true
