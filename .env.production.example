# ==============================================================================
# FinMatrix Backend — PRODUCTION .env TEMPLATE
#
# Copy this file to `.env.production` on your production host (or `.env` inside
# the container) and replace every placeholder with a real value.
# NEVER commit the filled-in file. NEVER reuse dev secrets.
#
# Generate strong secrets on the target host:
#   openssl rand -base64 48   # for JWT_SECRET / JWT_REFRESH_SECRET / COOKIE_SECRET
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24   # for DB_PASSWORD
# ==============================================================================

# ---- App ----
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
APP_NAME=FinMatrix
# Public URL the API is reachable at (used by Swagger & CORS). Include scheme.
APP_URL=https://api.your-domain.com

# ---- Database ----
# For a managed DB (RDS / DigitalOcean / Supabase), set DB_SSL=true.
DB_HOST=REPLACE_WITH_DB_HOST
DB_PORT=5432
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=finmatrix
# MUST be false in production. The app forces this regardless, but keep it false here.
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Set to true when connecting to any managed Postgres that requires TLS.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_POOL_MIN=4
# Auto-run migrations on container startup. Safe if your migrations are idempotent.
DB_MIGRATIONS_RUN=true

# ---- JWT ----
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_openssl_rand_base64_48
JWT_REFRESH_EXPIRES_IN=30d

# ---- Security ----
BCRYPT_ROUNDS=12
# Comma-separated list of allowed frontend origins. NO wildcards in prod.
CORS_ORIGINS=https://app.your-domain.com
THROTTLE_TTL=60
THROTTLE_LIMIT=100
COOKIE_SECRET=REPLACE_WITH_openssl_rand_base64_48

# ---- Logging ----
LOG_LEVEL=info
# Keep pretty=false in prod so logs are JSON (for log aggregators like Datadog, Loki).
LOG_PRETTY=false

# ---- File Uploads ----
UPLOAD_MAX_SIZE_MB=10
UPLOAD_STORAGE_PATH=/app/storage

# ---- Email (enable when SMTP is configured) ----
# true in production: verification, trial, activation and demo emails. With
# false every email is only written to the log.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FinMatrix <no-reply@your-domain.com>
# Optional: where replies go (a monitored support inbox).
SMTP_REPLY_TO=

# ---- Platform admin ----
# The inbox that receives "new trial / approval / activation / demo" notices.
# Must be a real, monitored inbox.
ADMIN_EMAIL=REPLACE_WITH_PLATFORM_ADMIN_INBOX
# Only for `npm run seed:superadmin:prod`; remove after seeding.
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

# ---- Secrets REQUIRED in production (the API refuses to start without) ----
# Signs company-backup download links. 32+ chars: openssl rand -base64 48
EXPORT_TOKEN_SECRET=REPLACE_WITH_openssl_rand_base64_48
# Encrypts the custodian copy of owner-issued staff/rider passwords.
# 32 bytes base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64
# Optional: signs item-photo URLs (otherwise derived from JWT_SECRET).
MEDIA_URL_SECRET=

# ---- File storage ----
# Cloudinary keeps uploads and backups durable across deploys. WITHOUT it,
# uploads go to Postgres but company-backup ZIPs go to UPLOAD_STORAGE_PATH on
# local disk — which must then be a persistent volume shared by every task
# (docker-compose.prod.yml mounts the named volume finmatrix_prod_storage).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ITEM_IMAGE_MAX_SIZE_MB=10

# ---- Error monitoring ----
# Sentry DSN; empty disables it. Events are scrubbed (no request bodies, no
# file contents, no amounts, user reduced to its id).
SENTRY_DSN=

# ---- Company backup (Settings → Backup & export) ----
EXPORT_WORKER_ENABLED=true
# Hours a finished backup can be downloaded (1–168).
EXPORT_RETENTION_HOURS=24

# ---- Migration Center ----
# Largest single uploaded file, bytes (default 25 MB, max 100 MB).
MIGRATION_MAX_FILE_BYTES=26214400
# Largest Peachtree backup (.ptb), bytes: sent in 8 MB pieces, held in the
# database only until read (default and max 2 GiB).
MIGRATION_MAX_UPLOAD_BYTES=2147483648
# The background reader for uploaded backups. Keep true on at least one task.
MIGRATION_READ_WORKER_ENABLED=true
# Days an untouched draft migration is kept before the cleanup sweep.
MIGRATION_DRAFT_RETENTION_DAYS=30
# false turns the nightly migration cleanup sweep off (tests).
MIGRATION_CLEANUP_ENABLED=true
# The optional AI mapping assistant. When on, only column headers, up to 20
# sample rows per sheet and the company's chart of accounts are sent to the
# model — never whole files. MIGRATION_AI_MODEL is required when enabled.
MIGRATION_AI_ENABLED=false
MIGRATION_AI_MODEL=
ANTHROPIC_API_KEY=
MIGRATION_AI_MAX_CALLS=10
MIGRATION_AI_SERVER_FALLBACK=true

# ---- Messaging (WhatsApp) ----
WHATSAPP_ENABLED=false
MESSAGING_ENCRYPTION_KEY=
MESSAGING_WORKER_ENABLED=true

# ---- Account control ----
ACCOUNT_DELETION_WORKER_ENABLED=true
# Days a deleted company's automatic final backup stays downloadable.
DELETION_BACKUP_RETENTION_DAYS=30

# ---- Feature Flags ----
# Disable Swagger in prod OR protect the path behind auth / IP allowlist in Nginx.
SWAGGER_ENABLED=false
SWAGGER_PATH=api/docs

# ---- Launch: sign-up paths and the free trial ----
# trial = "Start my free trial" + "Request approval"; approval = admin approval only.
# Rolling back the trial launch is SIGNUP_MODE=approval (no redeploy of code needed).
SIGNUP_MODE=trial
# false = every trial waits for an admin (emergency switch if abuse appears).
TRIAL_AUTO_APPROVE=true
TRIAL_DAYS=30
TRIAL_REMINDER_DAYS=7,3,1
TRIAL_RISK_MAX_IP_ATTEMPTS_24H=3
TRIAL_BLOCKED_EMAIL_DOMAINS=
DEMO_BOOKING_ENABLED=true
# A real, monitored inbox (NOT an @finmatrix.pk address until that domain receives mail).
SUPPORT_EMAIL=REPLACE_WITH_SUPPORT_INBOX
SUPPORT_WHATSAPP=
# The customer web app (links in every email). Include scheme, no trailing slash.
WEB_APP_URL=https://app.your-domain.com

# ── Book a Demo ──────────────────────────────────────────────────────────────
# Bookable slots in Asia/Karachi: days ahead, day start/end, slot minutes,
# ISO weekdays (1=Mon … 7=Sun) and how many demos may share a slot.
DEMO_SLOT_DAYS_AHEAD=14
DEMO_SLOT_DAY_START=10:00
DEMO_SLOT_DAY_END=18:00
DEMO_SLOT_MINUTES=30
DEMO_SLOT_WEEKDAYS=1,2,3,4,5,6
DEMO_SLOT_CAPACITY=1
# Optional Cloudflare Turnstile on the booking form (set both, or neither).
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# false stops this process from sending the 2-hours-before demo reminder.
DEMO_WORKER_ENABLED=true
